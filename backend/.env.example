# Real Human AI Video Interview System
# Environment Configuration Template
# Copy this file to .env and fill in your actual API keys

# =========================================
# AVATAR PROVIDER SELECTION
# =========================================
# Choose one: 'did' or 'heygen'
AVATAR_PROVIDER=did

# =========================================
# D-ID API (for real human avatars)
# =========================================
# Get your D-ID API key from: https://studio.d-id.com
# 1. Sign up at https://studio.d-id.com
# 2. Go to Account → API Keys
# 3. Create new API key
# 4. Copy the key below
DID_API_KEY=your_d_id_api_key_here

# =========================================
# HEYGEN API (alternative avatar provider)
# =========================================
# Get your HeyGen API key from: https://www.heygen.com
# 1. Sign up at https://www.heygen.com
# 2. Go to Account → API Keys
# 3. Create new API key
# 4. Copy the key below
HEYGEN_API_KEY=your_heygen_api_key_here

# =========================================
# OPENAI API (for GPT & Whisper)
# =========================================
# Get your OpenAI API key from: https://platform.openai.com
# 1. Sign up at https://platform.openai.com
# 2. Go to Account → API Keys
# 3. Create new secret key
# 4. Copy the key below
# IMPORTANT: Add billing method and set monthly usage limit to $10
OPENAI_API_KEY=sk-your_openai_api_key_here

# =========================================
# ELEVENLABS API (optional TTS)
# =========================================
# Get your ElevenLabs API key from: https://elevenlabs.io
# 1. Sign up at https://elevenlabs.io
# 2. Go to Account → API Key
# 3. Copy the key below (optional, only if using ElevenLabs for TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Default voice ID (Victoria - professional female voice)
# Other IDs available in ElevenLabs dashboard
ELEVENLABS_VOICE_ID=EXAVITQu4EsNXjFF2xPl

# =========================================
# SERVER CONFIGURATION
# =========================================
# Port number for the backend server
PORT=3000

# Environment: 'development' or 'production'
NODE_ENV=development

# =========================================
# OPTIONAL: Custom Avatars
# =========================================
# Upload your trained avatars and add their IDs here
# Format: AVATAR_[NAME]_DID_ID=your_avatar_id
# Example: AVATAR_CUSTOM_DID_ID=ava-xxxxx

# =========================================
# NOTES
# =========================================
# 1. All API keys are sensitive - never commit this file!
# 2. Start with one avatar provider (D-ID or HeyGen)
# 3. OpenAI API key is required for transcription and scoring
# 4. Test your setup with: curl http://localhost:3000/api/health
# 5. See REAL_INTERVIEW_SETUP.md for detailed setup instructions
